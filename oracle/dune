; Dev-only C oracle: the original libpcre2-8 bindings, kept for differential
; testing and as the perf baseline. Never part of the published pcre2 package.
; C symbols are oracle_-prefixed so this can link alongside the pure engine.
(library
 (name pcre2_c)
 (public_name pcre2-dev.oracle)
 (preprocess
  (pps ppx_inline_test ppx_deriving.show ppx_deriving.eq))
 (inline_tests)
 (foreign_stubs
  (language c)
  (names pcre2_c_stubs)
  (flags
   (:standard)
   (:include c_flags.sexp)
   -g))
 (c_library_flags
  (:include c_library_flags.sexp)
  (-g)))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (action
  (run ./config/discover.exe)))
