; Runs the exact same OUnit suite against the C oracle (Pcre2_c) to detect
; drift between the pure engine's contract and real PCRE2 behavior.
(rule
 (target pcre2_c_tests.ml)
 (deps ../pcre2_tests.ml)
 (action
  (copy %{deps} %{target})))

(test
 (name pcre2_c_tests)
 (package pcre2-dev)
 (modules pcre2_c_tests pcre2)
 (libraries pcre2-dev.oracle ounit2)
 (preprocess
  (pps ppx_deriving.show)))
