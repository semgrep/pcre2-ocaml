; pcre2test-compatible harness (dev-only). The library is a functor over the
; DRIVER seam (driver.ml); engine_driver adapts the pure engine to that seam
; (the C oracle's driver lives in oracle/, package pcre2-dev).
(library
 (name pcre2test_harness)
 (public_name pcre2-dev.pcre2test-harness)
 (modules flags ctl cstr pchars scan modifiers subject driver engine_driver
   harness)
 (libraries pcre2.engine))

(executable
 (name pcre2test_ml)
 (public_name pcre2test_ml)
 (package pcre2-dev)
 (modules pcre2test_ml)
 (libraries pcre2test_harness pcre2-dev.test-driver))
