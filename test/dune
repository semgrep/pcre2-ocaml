; The pcre2 unit suite: an Alcotest functor (MakeTests) instantiated over both
; Interp and Jit. Runs on the default @runtest (the @pure-tests alias is kept
; for targeted / libpcre2-free runs).

(executable
 (name pcre2_tests)
 (libraries pcre2 pcre2.engine alcotest)
 (preprocess
  (pps ppx_deriving.show)))

(rule
 (alias pure-tests)
 (action
  (run ./pcre2_tests.exe)))

(env
 (dev
  (flags
   (:standard -w -27))))

(rule
 (alias runtest)
 (action
  (run ./pcre2_tests.exe)))
